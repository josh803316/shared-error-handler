{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": false,
    "outDir": "./dist/cjs",
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "types": ["node"],
    "noEmit": false
  },
  "exclude": ["dist", "node_modules", "**/*.test.ts"]
}
